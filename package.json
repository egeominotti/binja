{
  "name": "binja",
  "version": "0.9.3",
  "type": "module",
  "description": "High-performance Jinja2/Django template engine for Bun",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "binja": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js"
    },
    "./ai": {
      "import": "./dist/ai/index.js",
      "require": "./dist/ai/index.js",
      "types": "./dist/ai/index.d.ts",
      "bun": "./dist/ai/index.js"
    },
    "./debug": {
      "import": "./dist/debug/index.js",
      "require": "./dist/debug/index.js",
      "types": "./dist/debug/index.d.ts",
      "bun": "./dist/debug/index.js"
    },
    "./hono": {
      "import": "./dist/adapters/hono.js",
      "require": "./dist/adapters/hono.js",
      "types": "./dist/adapters/hono.d.ts",
      "bun": "./dist/adapters/hono.js"
    },
    "./elysia": {
      "import": "./dist/adapters/elysia.js",
      "require": "./dist/adapters/elysia.js",
      "types": "./dist/adapters/elysia.d.ts",
      "bun": "./dist/adapters/elysia.js"
    },
    "./engines": {
      "import": "./dist/engines/index.js",
      "require": "./dist/engines/index.js",
      "types": "./dist/engines/index.d.ts",
      "bun": "./dist/engines/index.js"
    },
    "./engines/handlebars": {
      "import": "./dist/engines/handlebars/index.js",
      "require": "./dist/engines/handlebars/index.js",
      "types": "./dist/engines/handlebars/index.d.ts",
      "bun": "./dist/engines/handlebars/index.js"
    },
    "./engines/liquid": {
      "import": "./dist/engines/liquid/index.js",
      "require": "./dist/engines/liquid/index.js",
      "types": "./dist/engines/liquid/index.d.ts",
      "bun": "./dist/engines/liquid/index.js"
    },
    "./engines/twig": {
      "import": "./dist/engines/twig/index.js",
      "require": "./dist/engines/twig/index.js",
      "types": "./dist/engines/twig/index.d.ts",
      "bun": "./dist/engines/twig/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types && bun run build:clean",
    "build:js": "rm -rf ./dist && bun build ./src/index.ts ./src/cli.ts ./src/debug/index.ts ./src/ai/index.ts ./src/adapters/hono.ts ./src/adapters/elysia.ts ./src/engines/index.ts ./src/engines/handlebars/index.ts ./src/engines/liquid/index.ts ./src/engines/twig/index.ts --root ./src --outdir ./dist --target bun --minify --splitting --sourcemap=external --chunk-naming 'chunks/[name]-[hash].[ext]' --external @anthropic-ai/sdk --external openai",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir ./dist",
    "build:clean": "find dist -name '*.d.ts.map' -delete",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun run test/coverage-gate.ts",
    "test:property": "BINJA_PROPERTY_RUNS=1000 bun test test/property-based",
    "test:model": "bun test test/model-based",
    "test:fuzz": "BINJA_FUZZ_RUNS=5000 bun test test/fuzz --timeout 60000",
    "test:generative": "bun run test:property && bun run test:model && bun run test:fuzz",
    "test:examples": "bun run test/examples-smoke.ts",
    "test:package": "bun run test/package-smoke.ts",
    "test:soak": "bun test test/soak --dots",
    "test:stress": "bun test --rerun-each=2 --randomize --dots",
    "benchmark": "bun run benchmark/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.examples.json",
    "check": "bun run lint && bun run format:check",
    "check:fix": "bun run lint:fix && bun run format",
    "lint": "oxlint --deny-warnings src test benchmark",
    "lint:fix": "oxlint --fix --deny-warnings src test benchmark",
    "format": "oxfmt --write src test benchmark",
    "format:check": "oxfmt --check src test benchmark",
    "prepublishOnly": "bun run build",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release:patch": "bun run version:patch && bun run build",
    "release:minor": "bun run version:minor && bun run build",
    "release:major": "bun run version:major && bun run build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egeominotti/binja.git"
  },
  "homepage": "https://github.com/egeominotti/binja#readme",
  "bugs": {
    "url": "https://github.com/egeominotti/binja/issues"
  },
  "keywords": [
    "jinja2",
    "django",
    "template",
    "dtl",
    "bun",
    "ssr",
    "template-engine",
    "django-templates",
    "typescript"
  ],
  "author": "egeominotti",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@types/bun": "1.3.14",
    "elysia": "1.4.29",
    "fast-check": "4.9.0",
    "hono": "4.12.31",
    "husky": "9.1.7",
    "openai": "4.104.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "elysia": ">=1.0.0",
    "hono": ">=4.0.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "elysia": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
