#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Type check
echo "📘 TypeScript check..."
bun run typecheck
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Commit aborted."
  exit 1
fi

# Lint and format
echo "🔎 oxlint and oxfmt checks..."
bun run check
if [ $? -ne 0 ]; then
  echo "❌ Lint or formatting issues found. Run 'bun run check:fix' to fix safe issues."
  exit 1
fi

echo "✅ All checks passed!"
