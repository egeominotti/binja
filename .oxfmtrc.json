{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "test/views",
    "dist",
    "node_modules",
    "examples",
    "docs",
    "website"
  ],
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off"
}
